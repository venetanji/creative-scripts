# user's own anchor / reference images — don't commit
anchor.png
anchor.jpg
face.png
face.jpg
setting_shore.png
*.local.png
# generated outputs per-project (when someone runs a YAML next to the repo)
song.mp3
song_v*.mp3
song_meta.json
song_slices/
scenes/
stitch_check/
final*.mp4
run*.log
vram.jsonl
# Per-project render directories — when you render a yaml next to it, a
# matching folder picks up the song.mp3, anchor.png, sheets/, scenes/,
# stems/, midi/, transcripts, final.mp4 etc. We keep ONLY the .yaml in
# the repo; the rendered artifacts stay local.
music-videos/*/

# Pixel Dream is a source/documentation package, not a render directory.
!music-videos/pixel-dream/
music-videos/pixel-dream/**
!music-videos/pixel-dream/*.md
!music-videos/pixel-dream/workflows/
!music-videos/pixel-dream/workflows/*.md
!music-videos/pixel-dream/workflows/*.json
!music-videos/pixel-dream/procedural/
!music-videos/pixel-dream/procedural/*.md
!music-videos/pixel-dream/procedural/*.js
!music-videos/pixel-dream/procedural/*.html
!music-videos/pixel-dream/scripts/
!music-videos/pixel-dream/scripts/*.py
!music-videos/pixel-dream/tests/
!music-videos/pixel-dream/tests/test_*.py
!music-videos/pixel-dream/prompts/
!music-videos/pixel-dream/prompts/*.txt

# uv / python
__pycache__/
.venv/
